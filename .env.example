# このファイルを .env にコピーし、各値を設定。秘密情報を Git に登録しないこと。
# ローカルで直接起動する場合: set -a; . ./.env; set +a
DEMO=0
DEBUG=0
SECRET_KEY=
ALLOWED_HOSTS=leave.example.jp
CSRF_TRUSTED_ORIGINS=https://leave.example.jp
# Compose の HTTPS サーバー用
SITE_DOMAIN=leave.example.jp
# Compose: 長いランダム英数字に置き換える（URL に埋め込むため英数字推奨）
POSTGRES_PASSWORD=
# Compose は下記の代わりに内部 PostgreSQL 接続を自動設定します。
# 直接起動する場合のみ、必要なら設定。未設定なら共通サーバー上の SQLite。
# DATABASE_URL=postgresql://leave:URLエンコードしたパスワード@localhost:5432/leave
